{
  "expo": {
    "name": "FridgeMates",
    "slug": "fridgemates",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fridgemates",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF7EC",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rainier.fridgemates",
      "infoPlist": {
        "NSCameraUsageDescription": "FridgeMates uses the camera to scan your food and bring it to life.",
        "NSPhotoLibraryUsageDescription": "FridgeMates reads a photo of your food to bring it to life."
      }
    },
    "android": {
      "package": "com.rainier.fridgemates",
      "adaptiveIcon": {
        "backgroundColor": "#FF8A3D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF7EC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "FridgeMates uses the camera to photograph your fridge and estimate expiry dates.",
          "photosPermission": "FridgeMates reads a photo you choose so it can estimate expiry dates."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
