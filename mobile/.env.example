# Copy to .env (never committed). The Gemini key lives ONLY on the backend.
# For Expo Go on a phone, use your computer's LAN IP here instead of localhost.
EXPO_PUBLIC_API_URL=http://localhost:8000
# "true" = use src/api/mocks (works offline). Set to "false" once the backend is deployed.
EXPO_PUBLIC_USE_MOCK=true
# Only needed for the deployed backend: the shared token (ask Kenneth; never the Gemini key).
EXPO_PUBLIC_APP_TOKEN=
